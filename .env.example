# Eigene Zwischendatenbank der Check-in-App (nicht die Datenbank der API)
DATABASE_URL="mysql://checkin:passwort@127.0.0.1:3306/checkin"

# Datei mit dem Public Key: Die API schreibt sie ins gemeinsame Volume, die App liest nur.
# Der private Schlüssel gehört NICHT auf diesen Server.
CHECKIN_PUBLIC_KEY_DATEI=""
# Ohne gemeinsames Volume, z.B. in der Entwicklung: Public Key als SPKI in Base64 aus dem Center eintragen
CHECKIN_PUBLIC_KEY=""

# Nur hinter einem eigenen Reverse Proxy auf 1 setzen, sonst lässt sich X-Forwarded-For fälschen
TRUST_PROXY=0

# Prüf-Dialog vor dem Absenden, nur "false" oder "0" schalten ihn ab (Standard: an)
CHECKIN_PRUEFDIALOG=true

# Optional: Links auf Datenschutzerklärung und Impressum (http/https), leer = kein Link
CHECKIN_DATENSCHUTZ_URL=""
CHECKIN_IMPRESSUM_URL=""
